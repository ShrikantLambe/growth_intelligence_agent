# Copy this file to .env and set your API key
# cp .env.example .env

# ── LLM (pick one — priority: Anthropic → Google → OpenAI) ───────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here        # falls back to gemini-2.0-flash
# OPENAI_API_KEY=your_openai_api_key_here        # falls back to gpt-4o

# LLM model override
# Anthropic default: claude-haiku-4-5-20251001  (swap for claude-sonnet-4-6)
# Google default:    gemini-2.0-flash            (swap for gemini-1.5-pro)
LLM_MODEL=claude-haiku-4-5-20251001

# ── Vercel deployment (optional) ─────────────────────────────────────────────
# FRONTEND_URL=https://your-custom-domain.com    # sets allowed CORS origin
