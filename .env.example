# Copy this file to .env and set your API key
# cp .env.example .env

# ── LLM (pick one) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here        # falls back to gpt-4o

# LLM model (default shown; swap for claude-sonnet-4-6 for stronger reasoning)
LLM_MODEL=claude-haiku-4-5-20251001

# ── Vercel deployment (optional) ─────────────────────────────────────────────
# FRONTEND_URL=https://your-custom-domain.com    # sets allowed CORS origin
